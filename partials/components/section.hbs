<section{{#if id}} id="{{id}}"{{/if}} class="section u-container{{#if feature}} section--feature{{/if}}">
  {{#if copy}}
    {{#get 'pages' filter=copy limit='1'}}
      {{#foreach pages}}
        <div class="section__heading">
          {{content}}
        </div>
      {{/foreach}}
    {{/get}}
  {{/if}}
  <div class="section__content{{#if grid}} u-grid u-grid--{{grid}}{{/if}}">
    {{> @partial-block}}
  </div>
</section>
